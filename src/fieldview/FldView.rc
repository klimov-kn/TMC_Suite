    BUTTON      ID_VIEW_TOPOLOGY_BOUNDARY_EPS
    BUTTON      ID_VIEW_TOPOLOGY_BOUNDARY_METAL
    BUTTON      ID_VIEW_TOPOLOGY_BOUNDARY_MAGNETIC
