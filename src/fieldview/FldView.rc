/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MAINFRAME MENU 
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&New\tCtrl+N",                ID_FILE_NEW
        MENUITEM "&Open...\tCtrl+O",            ID_FILE_OPEN
        MENUITEM SEPARATOR
        MENUITEM "P&rint Setup...",             ID_FILE_PRINT_SETUP
        MENUITEM SEPARATOR
        MENUITEM "Recent File",                 ID_FILE_MRU_FILE1, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                       ID_APP_EXIT
    END
    POPUP "&View"
    BEGIN
        MENUITEM "&Toolbar",                    ID_VIEW_TOOLBAR
        MENUITEM "&Status Bar",                 ID_VIEW_STATUS_BAR
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About FldView...",           ID_APP_ABOUT
    END
END

IDR_FLDVIETYPE MENU 
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&New\tCtrl+N",                ID_FILE_NEW
        MENUITEM "&Open...\tCtrl+O",            ID_FILE_OPEN
        MENUITEM "&Close",                      ID_FILE_CLOSE
        MENUITEM "&Save\tCtrl+S",               ID_FILE_SAVE
        MENUITEM "Save &As...",                 ID_FILE_SAVE_AS
        MENUITEM SEPARATOR
        MENUITEM "&Print...\tCtrl+P",           ID_FILE_PRINT
        MENUITEM "Print Pre&view",              ID_FILE_PRINT_PREVIEW
        MENUITEM "P&rint Setup...",             ID_FILE_PRINT_SETUP
        MENUITEM SEPARATOR
        MENUITEM "Recent File",                 ID_FILE_MRU_FILE1, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                       ID_APP_EXIT
    END
    POPUP "&Edit"
    BEGIN
        MENUITEM "&Undo\tCtrl+Z",               ID_EDIT_UNDO
        MENUITEM SEPARATOR
        MENUITEM "Cu&t\tCtrl+X",                ID_EDIT_CUT
        MENUITEM "&Copy\tCtrl+C",               ID_EDIT_COPY
        MENUITEM "&Paste\tCtrl+V",              ID_EDIT_PASTE
    END
    POPUP "&View"
    BEGIN
        MENUITEM "&Parameters\tAlt+P",          ID_VIEW_PARAMETERS
        MENUITEM SEPARATOR
        POPUP "T&opology"
        BEGIN
            MENUITEM "&Line\tShift+L",              ID_FLAGDRAWLINETOP
            MENUITEM "S&urface\tShift+S",           ID_FLAGDRAWSURFACETOP
            MENUITEM "D&imension 2/3\tShift+D",     ID_DIMENSION23SWITCHTOP
            POPUP "Si&ze"
            BEGIN
                MENUITEM "along an X axies\tCtrl+J",    ID_VIEW_TOPOLOGY_DIMENSIONS_ALONGANXAXIES

                MENUITEM "along an Y axies\tShift+J",   ID_VIEW_TOPOLOGY_DIMENSIONS_ALONGANYAXIES

            END
            POPUP "Dimensions"
            BEGIN
                MENUITEM "Block\tK",                    ID_VIEW_TOPOLOGY_SIZE_BLOCK

                MENUITEM "Link_List\tAlt+K",            ID_VIEW_TOPOLOGY_SIZE_LINKLIST

            END
            POPUP "B&oundary"
            BEGIN
                MENUITEM "&Eps\tE",                     ID_VIEW_TOPOLOGY_BOUNDARY_EPS

                MENUITEM "&Metal\tM",                   ID_VIEW_TOPOLOGY_BOUNDARY_METAL

                MENUITEM "Mag&netic\tN",                ID_VIEW_TOPOLOGY_BOUNDARY_MAGNETIC

                MENUITEM "&Absorber\tA",                ID_VIEW_TOPOLOGY_BOUNDARY_ABSORBER

                MENUITEM "&Input\tI",                   ID_VIEW_TOPOLOGY_BOUNDARY_INPUT

            END
        END
        POPUP "&Eps"
        BEGIN
            MENUITEM "&Line\tAlt+L",                ID_FLAGDRAWLINEEPS
            MENUITEM "S&urface\tAlt+S",             ID_FLAGDRAWSURFACEEPS
            MENUITEM "D&imension 2/3\tAlt+D",       ID_DIMENSION23SWITCHEPS
            MENUITEM "Si&ze\tAlt+J",                ID_VIEW_EPS_SIZE
            POPUP "Type"
            BEGIN
                MENUITEM "Eps+",                        ID_EPS_TYPE_EPS
                MENUITEM "N - electron concentration",  ID_EPS_TYPE_N
                MENUITEM "Y - losses",                  ID_EPS_TYPE_Y
                MENUITEM "B - magnetic field",          ID_EPS_TYPE_B
            END
        END
        POPUP "&Field"
        BEGIN
            MENUITEM "&Line\tL",                    ID_FLAGDRAWLINE
            MENUITEM "S&urface\tS",                 ID_FLAGDRAWSURFACE
            MENUITEM "D&imension 2/3\tD",           ID_DIMENSION23SWITCH
            MENUITEM "Si&ze\tJ",                    ID_VIEW_FIELD_SIZE
            MENUITEM "L&evel\tAlt+E",               ID_FIELD_L
            MENUITEM "V&alue\tAlt+A",               ID_FIELD_VALUE
            MENUITEM "Modul\tAlt+M",                ID_FIELD_MODUL
        END
        MENUITEM SEPARATOR
        POPUP "Zoom"
        BEGIN
            MENUITEM "Zoom +\t+",                   ID_VIEW_ZOOM_P
            MENUITEM "Zoom +X\tX",                  ID_VIEW_ZOOM_PX
            MENUITEM "Zoom +Y\tY",                  ID_VIEW_ZOOM_PY
            MENUITEM "Zoom -\t-",                   ID_VIEW_ZOOM_M
            MENUITEM "Zoom -X\tShift+X",            ID_VIEW_ZOOM_MX
            MENUITEM "Zoom -Y\tShift+Y",            ID_VIEW_ZOOM_MY
        END
        POPUP "Rotate"
        BEGIN
            MENUITEM "Left\tCtrl+NumLock+4",        ID_ROTATE_LEFT
            MENUITEM "Right\tCtrl+NumLock+6",       ID_ROTATE_RIGHT
            MENUITEM SEPARATOR
            MENUITEM "Top\tCtrl+NumLock+8",         ID_ROTATE_TOP
            MENUITEM "Bottom\tCtrl+NumLock+2",      ID_ROTATE_BOTTOM
            MENUITEM SEPARATOR
            MENUITEM "Left_y\tCtrl+NumLock+1",      ID_ROTATE_LEFTY
            MENUITEM "Right_y\tCtrl+NumLock+7",     ID_ROTATE_RIGHTY
        END
        POPUP "Translate"
        BEGIN
            MENUITEM "X top\tAlt+NumLock+6",        ID_TRANSLATE_XT
            MENUITEM "X bottom\tAlt+NumLock+4",     ID_TRANSLATE_XB
            MENUITEM SEPARATOR
            MENUITEM "Y top\tAlt+NumLock+7",        ID_TRANSLATE_YT
            MENUITEM "Y bottom\tAlt+NumLock+1",     ID_TRANSLATE_YB
            MENUITEM SEPARATOR
            MENUITEM "Z top\tAlt+NumLock+8",        ID_TRANSLATE_ZT
            MENUITEM "Z bottom\tAlt+NumLock+2",     ID_TRANSLATE_ZB
        END
        MENUITEM SEPARATOR
        POPUP "Change Xmax, Xmin"
        BEGIN
            MENUITEM "Decrement\t<-",               ID_STRELKLEFT
            MENUITEM "Increment\t->",               ID_STRELKRIGHT
        END
        POPUP "Change Ymax, Ymin"
        BEGIN
            MENUITEM "Decrement\tV",                ID_STRELKDOWN
            MENUITEM "Increment\t^",                ID_STRELKUP
        END
        MENUITEM SEPARATOR
        MENUITEM "&Default\tCtrl+d",            ID_VIEW_DEFAULT12
        MENUITEM SEPARATOR
        MENUITEM "P&roportionally\tP",          ID_VIEW_PROPORTIONALLY
        MENUITEM SEPARATOR
        MENUITEM "&Toolbar",                    ID_VIEW_TOOLBAR
        MENUITEM "&Status Bar",                 ID_VIEW_STATUS_BAR
    END
    POPUP "&Window"
    BEGIN
        MENUITEM "&New Window",                 ID_WINDOW_NEW
        MENUITEM "&Cascade",                    ID_WINDOW_CASCADE
        MENUITEM "&Tile",                       ID_WINDOW_TILE_HORZ
        MENUITEM "&Arrange Icons",              ID_WINDOW_ARRANGE
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About FldView...",           ID_APP_ABOUT
    END
END


