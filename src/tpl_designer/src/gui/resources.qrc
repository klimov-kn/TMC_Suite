<!DOCTYPE RCC>
<!-- Стрелки счётчиков и выпадающих списков.

     Нужны именно файлом: в Qt подэлементы ::up-arrow / ::down-arrow рисуются только
     через image: url(...). Приём «нулевой размер плюс цветные рамки», которым
     треугольник делают в вебе, здесь даёт квадратик, а системная стрелка пропадает
     совсем, как только у самого поля застилизованы padding и border-radius. -->
<RCC version="1.0">
    <qresource prefix="/icons">
        <file>resources/arrow_up.svg</file>
        <file>resources/arrow_down.svg</file>
        <!-- Тот же .ico, что уходит в ресурс Windows: значок окна и значок файла
             обязаны совпадать, а две картинки однажды разъедутся. -->
        <file>resources/app.ico</file>
    </qresource>
</RCC>
