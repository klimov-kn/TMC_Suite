//
// Dialog
//

IDD_ABOUTBOX DIALOGEX 0, 0, 234, 71
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About  Tamic S-matrix Viewer"
FONT 8, "MS Sans Serif", 0, 0, 0x0
BEGIN
    ICON            IDR_MAINFRAME,IDC_STATIC,11,17,20,20
    LTEXT           "S-matrix Output Characteristics Viewer ",IDC_STATIC,40,
                    5,180,10,SS_NOPREFIX
    LTEXT           "Copyright © 2001-2005 Tamic_soft group",IDC_STATIC,40,
                    27,125,8
    DEFPUSHBUTTON   "OK",IDOK,179,32,45,14,WS_GROUP
    LTEXT           "Version 5.1",IDC_STATIC,40,16,40,10,SS_NOPREFIX
    LTEXT           "www.tamic.ru",IDC_STATIC,51,38,106,8
    LTEXT           "",IDC_TMC_DOCLINK,40,56,170,10,SS_NOTIFY | WS_TABSTOP
END

