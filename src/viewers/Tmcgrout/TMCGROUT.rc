//
// Accelerator
//

IDR_MAINFRAME ACCELERATORS 
BEGIN
    "+",            ID_VIEW_ZOOM_ZOOMP,     ASCII,  NOINVERT
    "-",            ID_VIEW_ZOOM_ZOOM,      ASCII,  NOINVERT
    "<",            ID_VIEW_CHANGEXMAXXMIN_DECRIMENT, ASCII, NOINVERT
    ">",            ID_VIEW_CHANGEXMAXXMIN_INCREMENT, ASCII, NOINVERT
    "A",            ID_EDIT_ADDCHARACTERISTICS, VIRTKEY, CONTROL, NOINVERT
    "C",            ID_EDIT_COPY,           VIRTKEY, CONTROL, NOINVERT
    "D",            ID_EDIT_DOCUMENT,       VIRTKEY, CONTROL, NOINVERT
    "H",            ID_EDIT_GRAPHICSPARAMETERS, VIRTKEY, CONTROL, NOINVERT
    "N",            ID_FILE_NEW,            VIRTKEY, CONTROL, NOINVERT
    "O",            ID_FILE_OPEN,           VIRTKEY, CONTROL, NOINVERT
    "P",            ID_FILE_PRINT,          VIRTKEY, CONTROL, NOINVERT
    "R",            ID_VIEW_RESIZECTRLR,    VIRTKEY, CONTROL, NOINVERT
    "S",            ID_FILE_SAVE,           VIRTKEY, CONTROL, NOINVERT
    "T",            ID_VIEW_RESIZEWINDOW,   VIRTKEY, CONTROL, NOINVERT
    "V",            ID_VIEW_CHANGEYMAXYMIN_DECREMENT, VIRTKEY, NOINVERT
    "V",            ID_EDIT_PASTE,          VIRTKEY, CONTROL, NOINVERT
    VK_BACK,        ID_EDIT_UNDO,           VIRTKEY, ALT, NOINVERT
    VK_DELETE,      ID_EDIT_CUT,            VIRTKEY, SHIFT, NOINVERT
    VK_DOWN,        ID_VIEW_CHANGEYMAXYMIN_DECREMENT, VIRTKEY, NOINVERT
    VK_END,         ID_VIEW_TRANSLATE_END,  VIRTKEY, NOINVERT
    VK_F1,          ID_APP_ABOUT,           VIRTKEY, NOINVERT
    VK_F6,          ID_NEXT_PANE,           VIRTKEY, NOINVERT
    VK_F6,          ID_PREV_PANE,           VIRTKEY, SHIFT, NOINVERT
    VK_F7,          ID_EDIT_EDIT,           VIRTKEY, ALT, NOINVERT
    VK_HOME,        ID_VIEW_TRANSLATE_HOME, VIRTKEY, NOINVERT
    VK_INSERT,      ID_EDIT_COPY,           VIRTKEY, CONTROL, NOINVERT
    VK_INSERT,      ID_EDIT_PASTE,          VIRTKEY, SHIFT, NOINVERT
    VK_LEFT,        ID_VIEW_CHANGEXMAXXMIN_DECRIMENT, VIRTKEY, NOINVERT
    VK_RIGHT,       ID_VIEW_CHANGEXMAXXMIN_INCREMENT, VIRTKEY, NOINVERT
    VK_UP,          ID_VIEW_CHANGEYMAXYMIN_INCREMENT, VIRTKEY, NOINVERT
    "W",            ID_VIEW_GRAPHICS,       VIRTKEY, CONTROL, NOINVERT
    "X",            ID_VIEW_ZOOM_ZOOMXP,    VIRTKEY, NOINVERT
    "X",            ID_EDIT_CUT,            VIRTKEY, CONTROL, NOINVERT
    "X",            ID_VIEW_AUTOXSIZE,      VIRTKEY, ALT, NOINVERT
    "X",            ID_VIEW_ZOOM_ZOOMX,     VIRTKEY, SHIFT, NOINVERT
    "Y",            ID_VIEW_ZOOM_ZOOMYP,    VIRTKEY, NOINVERT
    "Y",            ID_VIEW_AUTOYSIZE,      VIRTKEY, ALT, NOINVERT
    "Y",            ID_VIEW_ZOOM_ZOOMY,     VIRTKEY, SHIFT, NOINVERT
    "Z",            ID_EDIT_UNDO,           VIRTKEY, CONTROL, NOINVERT
    94,             ID_VIEW_CHANGEYMAXYMIN_INCREMENT, ASCII, NOINVERT
END


