//
// Bitmap
//

IDR_MAINFRAME           BITMAP                  "res\\Toolbar.bmp"

/////////////////////////////////////////////////////////////////////////////
//
// Toolbar
//

IDR_MAINFRAME TOOLBAR  16, 15
BEGIN
    BUTTON      ID_FILE_OPEN
    SEPARATOR
    BUTTON      ID_EDIT_ADDCHARACTERISTICS
    BUTTON      ID_EDIT_DOCUMENT
    SEPARATOR
    BUTTON      ID_EDIT_GRAPHICSPARAMETERS
    BUTTON      ID_VIEW_GRAPHICS
    SEPARATOR
    BUTTON      ID_VIEW_RESIZECTRLR
    SEPARATOR
    BUTTON      ID_VIEW_ZOOM_ZOOMP
    BUTTON      ID_VIEW_ZOOM_ZOOMXP
    BUTTON      ID_VIEW_ZOOM_ZOOMYP
    BUTTON      ID_VIEW_ZOOM_ZOOM
    BUTTON      ID_VIEW_ZOOM_ZOOMX
    BUTTON      ID_VIEW_ZOOM_ZOOMY
    SEPARATOR
    BUTTON      ID_VIEW_RESIZEWINDOW
    BUTTON      ID_VIEW_AUTOXSIZE
    BUTTON      ID_VIEW_AUTOYSIZE
    SEPARATOR
    BUTTON      ID_VIEW_TRANSLATE_HOME
    BUTTON      ID_VIEW_TRANSLATE_END
    BUTTON      ID_VIEW_CHANGEXMAXXMIN_DECRIMENT
    BUTTON      ID_VIEW_CHANGEXMAXXMIN_INCREMENT
    BUTTON      ID_VIEW_CHANGEYMAXYMIN_DECREMENT
    BUTTON      ID_VIEW_CHANGEYMAXYMIN_INCREMENT
    SEPARATOR
    BUTTON      ID_FILE_PRINT
    BUTTON      ID_APP_ABOUT
END


/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MAINFRAME MENU 
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&New\tCtrl+N",                ID_FILE_NEW
        MENUITEM "&Open...\tCtrl+O",            ID_FILE_OPEN
        MENUITEM SEPARATOR
        MENUITEM "P&rint Setup...",             ID_FILE_PRINT_SETUP
        MENUITEM SEPARATOR
        MENUITEM "Recent File",                 ID_FILE_MRU_FILE1, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                       ID_APP_EXIT
    END
    POPUP "&View"
    BEGIN
        MENUITEM "&Toolbar",                    ID_VIEW_TOOLBAR
        MENUITEM "&Status Bar",                 ID_VIEW_STATUS_BAR
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About TMCGROUT...",          ID_APP_ABOUT
    END
END

IDR_TMCGROTYPE MENU 
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&New\tCtrl+N",                ID_FILE_NEW
        MENUITEM "&Open...\tCtrl+O",            ID_FILE_OPEN
        MENUITEM "&Close",                      ID_FILE_CLOSE
        MENUITEM "&Save\tCtrl+S",               ID_FILE_SAVE
        MENUITEM "Save &As...",                 ID_FILE_SAVE_AS
        MENUITEM SEPARATOR
        MENUITEM "&Print...\tCtrl+P",           ID_FILE_PRINT
        MENUITEM "Print Pre&view",              ID_FILE_PRINT_PREVIEW
        MENUITEM "P&rint Setup...",             ID_FILE_PRINT_SETUP
        MENUITEM SEPARATOR
        MENUITEM "Recent File",                 ID_FILE_MRU_FILE1, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                       ID_APP_EXIT
    END
    POPUP "&Edit"
    BEGIN
        MENUITEM SEPARATOR
        MENUITEM "&Characteristics\tCtrl+D",    ID_EDIT_DOCUMENT
        MENUITEM "&Add characteristics\tCtrl+A", ID_EDIT_ADDCHARACTERISTICS
        MENUITEM "&Editor\tAlt+F7",             ID_EDIT_EDIT
    END
    POPUP "&View"
    BEGIN
        MENUITEM "&Viewport\tCtrl+H",           ID_EDIT_GRAPHICSPARAMETERS
        MENUITEM "Redra&w data\tCtrl+W",        ID_VIEW_GRAPHICS
        MENUITEM SEPARATOR
        POPUP "Zoom"
        BEGIN
            MENUITEM "&ReSize viewport\tCtrl+R",    ID_VIEW_RESIZECTRLR
            MENUITEM SEPARATOR
            MENUITEM "Zoom +\t+",                   ID_VIEW_ZOOM_ZOOMP
            MENUITEM "Zoom +X\tX",                  ID_VIEW_ZOOM_ZOOMXP
            MENUITEM "Zoom +Y\tY",                  ID_VIEW_ZOOM_ZOOMYP
            MENUITEM "Zoom -\t-",                   ID_VIEW_ZOOM_ZOOM
            MENUITEM "Zoom -X\tShift+X",            ID_VIEW_ZOOM_ZOOMX
            MENUITEM "Zoom -Y\tShift+Y",            ID_VIEW_ZOOM_ZOOMY
            MENUITEM SEPARATOR
            MENUITEM "R&esize window\tCtrl+T",      ID_VIEW_RESIZEWINDOW
            MENUITEM "Auto X size\t Alt+X",         ID_VIEW_AUTOXSIZE
            MENUITEM "Auto Y size\t Alt+Y",         ID_VIEW_AUTOYSIZE
        END
        POPUP "Translate"
        BEGIN
            POPUP "Change Xmax, Xmin"
            BEGIN
                MENUITEM "Decrement \t<-",              ID_VIEW_CHANGEXMAXXMIN_DECRIMENT

                MENUITEM "Increment \t->",              ID_VIEW_CHANGEXMAXXMIN_INCREMENT

                MENUITEM "Home\tHome",                  ID_VIEW_TRANSLATE_HOME

                MENUITEM "End\tEnd",                    ID_VIEW_TRANSLATE_END

            END
            POPUP "Change Ymax, Ymin"
            BEGIN
                MENUITEM "Decrement \tV",               ID_VIEW_CHANGEYMAXYMIN_DECREMENT

                MENUITEM "Increment \t^",               ID_VIEW_CHANGEYMAXYMIN_INCREMENT

            END
        END
        MENUITEM SEPARATOR
        MENUITEM "&Status Bar",                 ID_VIEW_STATUS_BAR
        MENUITEM "&Toolbar",                    ID_VIEW_TOOLBAR
    END
    POPUP "&Config"
    BEGIN
        MENUITEM "&Editor",                     ID_CONFIG_EDITOR
        POPUP "&Color"
        BEGIN
            MENUITEM "&Background",                 ID_CONFIG_COLOR_BACKGROUND

            MENUITEM "&Grid",                       ID_CONFIG_COLOR_GRID
            MENUITEM "&Axies",                      ID_CONFIG_COLOR_AXIS
            MENUITEM "&Point",                      ID_CONFIG_COLORPOINT
            MENUITEM "&Graphics",                   ID_CONFIG_COLOR_GRAPHICS
        END
        MENUITEM "&Font",                       ID_CONFIG_FONT
    END
    POPUP "&Window"
    BEGIN
        MENUITEM "&New Window",                 ID_WINDOW_NEW
        MENUITEM "&Cascade",                    ID_WINDOW_CASCADE
        MENUITEM "&Tile",                       ID_WINDOW_TILE_HORZ
        MENUITEM "&Arrange Icons",              ID_WINDOW_ARRANGE
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About TMCGROUT...",          ID_APP_ABOUT
    END
END


