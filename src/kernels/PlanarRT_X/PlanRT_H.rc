/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MAINFRAME MENU 
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&New\tCtrl+N",                ID_FILE_NEW
        MENUITEM "&Open...\tCtrl+O",            ID_FILE_OPEN
        MENUITEM SEPARATOR
        MENUITEM "P&rint Setup...",             ID_FILE_PRINT_SETUP
        MENUITEM SEPARATOR
        MENUITEM "Recent File",                 ID_FILE_MRU_FILE1, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                       ID_APP_EXIT
    END
    POPUP "&View"
    BEGIN
        MENUITEM "&Toolbar",                    ID_VIEW_TOOLBAR
        MENUITEM "&Status Bar",                 ID_VIEW_STATUS_BAR
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About PlanRT_X...",          ID_APP_ABOUT
    END
END

IDR_PLANRTTYPE MENU 
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&New\tCtrl+N",                ID_FILE_NEW
        MENUITEM "&Open...\tCtrl+O",            ID_FILE_OPEN
        MENUITEM "&Close",                      ID_FILE_CLOSE
        MENUITEM "&Save\tCtrl+S",               ID_FILE_SAVE
        MENUITEM "Save &As...",                 ID_FILE_SAVE_AS
        MENUITEM SEPARATOR
        MENUITEM "&Print...\tCtrl+P",           ID_FILE_PRINT
        MENUITEM "Print Pre&view",              ID_FILE_PRINT_PREVIEW
        MENUITEM "P&rint Setup...",             ID_FILE_PRINT_SETUP
        MENUITEM SEPARATOR
        MENUITEM "Recent File",                 ID_FILE_MRU_FILE1, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                       ID_APP_EXIT
    END
    POPUP "&Edit"
    BEGIN
        MENUITEM "&Edit\tAlt+F7",               ID_EDIT_EDIT
        MENUITEM SEPARATOR
        MENUITEM "&Undo\tCtrl+Z",               ID_EDIT_UNDO
        MENUITEM SEPARATOR
        MENUITEM "Cu&t\tCtrl+X",                ID_EDIT_CUT
        MENUITEM "&Copy\tCtrl+C",               ID_EDIT_COPY
        MENUITEM "&Paste\tCtrl+V",              ID_EDIT_PASTE
    END
    POPUP "&View"
    BEGIN
        MENUITEM "Outp&ut\tAlt+Shift+F4",       ID_VIEW_OUTPUT
        MENUITEM "&Field and topology",         ID_VIEW_FIELD_1
        MENUITEM "St&atistics\tShift+F4",       ID_VIEW_STATISTICS
        MENUITEM "S-&matrix\tCtrl+Shift+F4",    ID_CONFIG_SMATRIX
        MENUITEM "&Directional Pattern\tCtrl+Alt+F4", 
                                                ID_VIEW_DIRECTIONALPATTERN
        MENUITEM SEPARATOR
        MENUITEM "&Toolbar",                    ID_VIEW_TOOLBAR
        MENUITEM "&Status Bar",                 ID_VIEW_STATUS_BAR
    END
    POPUP "&Run"
    BEGIN
        MENUITEM "Run\tF5",                     ID_RUN_RUN
        MENUITEM "Load first step\tShift+F5",   ID_RUN_RESTARTALL
        MENUITEM SEPARATOR
        MENUITEM "Run Step\tF8",                ID_RUN_STARTSTEP
        MENUITEM "Load Step\tShift+F8",         ID_RUN_RESTARTSTEP
        MENUITEM SEPARATOR
        MENUITEM "Skip Step\tCtrl+F6",          ID_RUN_SKIPSTEP
        MENUITEM "Back Step\tAlt+F6",           ID_RUN_BACKSTEP
        MENUITEM SEPARATOR
        MENUITEM "&Stop\tAlt+F5",               ID_RUN_STOP
    END
    POPUP "&Config"
    BEGIN
        MENUITEM "&Editor",                     ID_CONFIG_EDITOR
        MENUITEM SEPARATOR
        POPUP "Viewer"
        BEGIN
            MENUITEM "&Output signal",              ID_CONFIG_VIEWER_OUTPUTSIGNAL

            MENUITEM "&Field",                      ID_CONFIG_VIEWER_FIELD
            MENUITEM "&S-matrix",                   ID_CONFIG_VIEWER_SMATRIX
            MENUITEM "Directional Pattern",         ID_CONFIG_VIEWER_DIRECTIONALPATTERN

        END
        POPUP "&Color"
        BEGIN
            MENUITEM "&BackGround",                 ID_CONFIG_COLOR_BACKGROUND

        END
        POPUP "&Format"
        BEGIN
            MENUITEM "&OutputDataFile",             ID_CONFIG_FORMAT_OUTPUTDATAFILE

        END
        MENUITEM SEPARATOR
        MENUITEM "T&opology\tF4",               ID_VIEW_TOPOLOGY
        MENUITEM "&Field\tCtrl+F4",             ID_VIEW_FIELD
        MENUITEM "&Synchronization",            ID_CONFIG_SINCHRONIZATION
        MENUITEM "&Directional Pattern",        ID_CONFIG_DIRECTIONALPATTERN
        MENUITEM SEPARATOR
        POPUP "Sound"
        BEGIN
            MENUITEM "On/Off",                      ID_CONFIG_SOUND
            MENUITEM "Melody",                      ID_CONFIG_SOUND_MELODY
        END
        MENUITEM "&AutoRun",                    ID_CONFIG_AUTORUN
        MENUITEM "Setup",                       ID_CONFIG_SETUP
    END
    POPUP "&Window"
    BEGIN
        MENUITEM "&Cascade",                    ID_WINDOW_CASCADE
        MENUITEM "&Tile",                       ID_WINDOW_TILE_HORZ
        MENUITEM "&Arrange Icons",              ID_WINDOW_ARRANGE
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About PlanRT_X...",          ID_APP_ABOUT
    END
END


