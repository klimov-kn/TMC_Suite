# ============================================================
#  TMC Suite - .gitignore (MinGW / Qt 6 / CMake / Windows)
# ============================================================

# --- Build output: intermediate files, logs ---
/build/obj/
/build/obj_*/
/build/*.log

# --- Binaries: distributed via GitHub Releases, not committed ---
# See dist/README.md
/dist/win64/
/dist/TMC_Suite_Qt6_win64/
*.exe
*.dll
*.a
*.obj
*.o
!/src/tpl_designer/data/models/*.obj

# --- Installer build output (setup .exe -> GitHub Releases) ---
/installer/Output/

# --- Test data sets and development tools (not published) ---
/samples/
/tools/

# --- Python helpers ---
__pycache__/
*.pyc
*.pyo

# --- Archives / temporary dumps ---
*.zip
*.7z
*.rar

# --- Editor / OS junk ---
.vs/
.vscode/
*.user
Thumbs.db
ehthumbs.db
Desktop.ini
*~
*.bak
*.orig
*.tmp
*.log
